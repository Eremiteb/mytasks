[Unit]
Description=Проверка логов сервера: через 10 минут после запуска системы и далее раз в сутки

[Timer]
# 10 минут от загрузки системы; если сеанс пользователя начался позже, срабатывает сразу после входа
OnBootSec=10min
# При непрерывной работе системы — повтор раз в сутки после предыдущего запуска
OnUnitActiveSec=1d
Unit=llamactl-logcheck.service

[Install]
WantedBy=timers.target
