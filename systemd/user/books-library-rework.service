[Unit]
Description=Библиотека книг: переделка библиотеки — ночная обработка и индексация /mnt/copy/Books (scan, fix-encoding, convert, unpack-collections, sort-underscore, merge-authors, author-variants, fix-misplaced, dedup, dedup-folders, strip-suffix, name-variants, windows-names, check-folders, scan)
Documentation=file://@MYTASKS_DIR@/books_library/README.md
# Одновременный запуск scan и кнопки «Пересканировать» исключён блокировкой движка (код 3 — не повторять).
StartLimitIntervalSec=2h
StartLimitBurst=4

[Service]
Type=oneshot
# Обработка может идти часами (Calibre, сверка дубликатов): не обрывать по умолчанию-тайм-ауту systemd.
TimeoutStartSec=infinity
# Порядок конвейера: сначала scan (новые книги попадают в индекс), затем служебные режимы и итоговый scan.
# «-» — сбой режима не мешает итоговому scan; отдельные файлы режимы и так не останавливают.
ExecStart=/usr/bin/env python3 -I @MYTASKS_DIR@/books_library/books_library.py scan
ExecStart=-/usr/bin/env python3 -I @MYTASKS_DIR@/books_library/books_library.py fix-encoding
ExecStart=-/usr/bin/env python3 -I @MYTASKS_DIR@/books_library/books_library.py convert --only fb2
ExecStart=-/usr/bin/env python3 -I @MYTASKS_DIR@/books_library/books_library.py unpack-collections
ExecStart=-/usr/bin/env python3 -I @MYTASKS_DIR@/books_library/books_library.py sort-underscore
ExecStart=-/usr/bin/env python3 -I @MYTASKS_DIR@/books_library/books_library.py merge-authors
ExecStart=-/usr/bin/env python3 -I @MYTASKS_DIR@/books_library/books_library.py author-variants
ExecStart=-/usr/bin/env python3 -I @MYTASKS_DIR@/books_library/books_library.py fix-misplaced
ExecStart=-/usr/bin/env python3 -I @MYTASKS_DIR@/books_library/books_library.py dedup
ExecStart=-/usr/bin/env python3 -I @MYTASKS_DIR@/books_library/books_library.py dedup-folders
ExecStart=-/usr/bin/env python3 -I @MYTASKS_DIR@/books_library/books_library.py strip-suffix
ExecStart=-/usr/bin/env python3 -I @MYTASKS_DIR@/books_library/books_library.py name-variants
ExecStart=-/usr/bin/env python3 -I @MYTASKS_DIR@/books_library/books_library.py windows-names
ExecStart=-/usr/bin/env python3 -I @MYTASKS_DIR@/books_library/books_library.py check-folders
ExecStart=/usr/bin/env python3 -I @MYTASKS_DIR@/books_library/books_library.py scan
# Конфигурация (2) и уже идущее сканирование (3) повтором не лечатся.
RestartPreventExitStatus=2 3
# Низкий приоритет CPU и дисковой очереди: обработка не должна мешать остальным задачам.
Nice=10
IOSchedulingClass=idle
MemoryMax=8G

# Ограничения: файлы книг меняют только служебные режимы (fix-encoding, convert, unpack-collections, sort-underscore, merge-authors,
# author-variants (склейка только по same_person: разные люди не склеиваются),
# fix-misplaced, dedup, dedup-folders, strip-suffix, name-variants, windows-names); удаляемое и заменяемое уходит в карантин /mnt/copy/Books-removed, а не
# удаляется; папки авторов склеиваются и переименовываются без карантина (журнал прогона — для отката). Запись — в каталог библиотеки (БД), логи,
# каталог книг, карантин и кэш текста dedup (/var/cache/books_library, «-» — не ошибка, если каталога нет).
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=@MYTASKS_DIR@/books_library @MYTASKS_DIR@/logs -/mnt/copy/Books -/mnt/copy/Books-removed -/var/cache/books_library
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
