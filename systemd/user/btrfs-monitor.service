[Unit]
Description=Проверка счётчиков ошибок Btrfs корневого раздела (btrfs_monitor.sh)
Documentation=file://@MYTASKS_DIR@/README.md

[Service]
Type=oneshot
ExecStart=@MYTASKS_DIR@/btrfs_monitor.sh
# Код 1 — найден рост счётчиков ошибок: скрипт уже записал лог и показал
# уведомление, это штатный результат проверки, а не сбой юнита
SuccessExitStatus=1
