[Unit]
Description=Проверка логов сервера esimych-cloud локальной моделью llama.cpp (llamactl logcheck)
Documentation=file://@MYTASKS_DIR@/README.md
After=network-online.target

[Service]
Type=oneshot
ExecStart=@MYTASKS_DIR@/llamactl/llamactl.sh logcheck
# Код 1 — модель нашла проблемы, 3 — пропущено (GPU занята): итог уже в
# уведомлении и трее, это штатный результат, а не сбой юнита
SuccessExitStatus=1 3
# Ожидание свободной GPU (LOGCHECK_WAIT_SECS, 30 мин) плюс загрузка и ответ модели
TimeoutStartSec=1h
Nice=10
