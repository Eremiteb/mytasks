[Unit]
Description=Библиотека книг: переделка библиотеки — ночная обработка и индексация ежедневно в 04:30 и через 10 мин после загрузки

[Timer]
OnCalendar=*-*-* 04:30:00
# Через 10 мин после каждой загрузки (OnBootSec; OnActiveSec срабатывал и после каждой активации таймера):
# иначе каталог пустой до ближайших 04:30. Повторное сканирование инкрементальное и быстрое.
OnBootSec=10min
# Пропущенный запуск (компьютер был выключен) выполняется сразу после загрузки.
Persistent=true
# Случайная задержка до 10 мин: не запускать вместе с другими задачами.
RandomizedDelaySec=10min
Unit=books-library-rework.service

[Install]
WantedBy=timers.target
