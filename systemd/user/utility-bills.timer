[Unit]
Description=Квитанции ЖКУ: 20-го числа каждого месяца в 10:00, пропущенный запуск — после загрузки

[Timer]
OnCalendar=*-*-20 10:00:00
# Если 20-го в 10:00 компьютер был выключен, запуск выполняется сразу после следующей загрузки
Persistent=true
Unit=utility-bills.service

[Install]
WantedBy=timers.target
