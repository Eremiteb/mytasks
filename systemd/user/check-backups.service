[Unit]
Description=Проверка каталогов с архивами резервных копий (лог + уведомление в трее)
Documentation=file://@MYTASKS_DIR@/README.md
# Проверка целостности читает архивы с того же NAS, куда пишет sources.sh:
# если копирование уже запущено (например, догоняющий запуск после загрузки),
# проверка начинается после него
After=sources.service

[Service]
Type=oneshot
ExecStart=@MYTASKS_DIR@/check_backups.sh
# Код 1 — найдены проблемы с бэкапами: скрипт уже записал лог и показал
# уведомление, это штатный результат, а не сбой юнита
SuccessExitStatus=1
