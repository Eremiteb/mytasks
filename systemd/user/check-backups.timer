[Unit]
Description=Проверка бэкапов: через 4 минуты после запуска системы и далее раз в сутки

[Timer]
# 4 минуты от загрузки системы; если сеанс пользователя начался позже, срабатывает сразу после входа
OnBootSec=4min
# При непрерывной работе системы — повтор раз в сутки после предыдущего запуска
OnUnitActiveSec=1d
Unit=check-backups.service

[Install]
WantedBy=timers.target
