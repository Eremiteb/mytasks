# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
ENV/
env/
.conda/

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# Python tooling
.pytest_cache/
.mypy_cache/
.pyre/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# IDE / editor
.vscode/
.idea/
*.swp
.claude/

# OS files
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Runtime state (генерируется скриптами, привязан к конкретной машине)
state/*
!state/.gitkeep

# HTML-отчёты system_monitor.sh (генерируются скриптом, привязаны к машине)
system_reports/*
!system_reports/.gitkeep

# Configuration files (keep directory structure)
conf/*
!conf/.gitkeep
!conf/*.conf.example

# Local project directories (exclude from GitHub)
/music_downloader-dev/
/newline_to_space/
.sources.err*
.sources.out*
*.sync-conflict

# Graphify (generated code graph)
graphify-out/
