            "base_url": "https://lmu.kz",
            "categories": [
                "/sections/kazakhstan"
            ]
        },
        {
            "site_name": "tunes_kz",
            "site_script": "drivers/music_downloader_tunes_kz.py",
            "base_url": "https://tunes.kz",
            "categories": [
                "/"
            ]
        },
        {
            "site_name": "jamendo_com",
            "site_script": "drivers/music_downloader_jamendo_com.py",
            "base_url": "https://jamendo.com",
            "client_id": "YOUR_JAMENDO_CLIENT_ID",
            "categories": [
                "/"
            ]
        },
        {
            "site_name": "shazam_com",
            "site_script": "drivers/music_downloader_shazam.py",
            "base_url": "https://www.shazam.com",
            "categories": [
                "/ru-ru/charts/top-200/world"
            ]
        },
        {
            "site_name": "mychords_net",
            "site_script": "drivers/music_downloader_mychords_net.py",
            "base_url": "https://music.mychords.net",
            "categories": [
                "/ru/novinki"
            ]
        },
        {
            "site_name": "beufm_kz",
            "site_script": "drivers/music_downloader_beufm_kz.py",
            "base_url": "https://beufm.kz",
            "recorder": {
                "enabled": true,
                "stream_url": "https://stream.beufm.kz/beufm",
                "now_playing_url": "https://beufm.kz/1.txt",
                "dir": "../state/beufm_recordings",
                "takes": 3,
                "min_takes": 2,
                "max_wait_days": 7,
                "keep_days": 14,
                "max_mb": 2048,
                "aired_file": "aired.jsonl",
                "aired_lookback_days": 2,
                "aired_keep_days": 14,
                "maintenance_minutes": 60,
                "bitrate_kbps": 192,
                "log_max_files": 10,
                "user_agent": "Mozilla/5.0 (X11; Linux x86_64; rv:130.0) Gecko/20100101 Firefox/130.0",
                "stream_timeout_seconds": 20,
                "now_playing_timeout_seconds": 10,
                "reconnect_seconds": 10,
                "fpcalc_timeout_seconds": 120,
                "ffmpeg_timeout_seconds": 300
            },
            "categories": [
                "/"
            ]
        }
    ]
}
