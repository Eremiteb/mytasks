{
    "log_cleanup_days": 10,
    "log_max_files": 10,

    "file_permissions": {
        "enabled": true,
        "mode": "0666"
    },

    "download_paths": [
        {
            "path": "/mnt/copy/Music/_cloud/",
            "max_size_mb": 3072
        },
        {
            "path": "/var/downloads/clouddata/syncthing/Music/_cloud/",
            "max_size_mb": 3072
        }
    ],

    "search_sources": [
        {
            "name": "sefon.pro",
            "enabled": true,
            "driver": "drivers/music_downloader_sefon_pro.py",
            "base_url": "https://sefon.pro",
            "search_path": "/search/?q={query}"
        },
        {
            "name": "lmusic_kz",
            "enabled": true,
            "driver": "drivers/music_downloader_lmusic_kz.py",
            "base_url": "https://lmusic.kz",
            "search_path": "/search?q={query}"
        },
        {
            "name": "muzofond",
            "enabled": true,
            "driver": "drivers/music_downloader_muzofond.py",
            "base_url": "https://muzofond.fm",
            "search_path": "/search/{query_path}"
        },
        {
            "name": "drivemusic",
            "enabled": true,
            "driver": "drivers/music_downloader_drivemusic.py",
            "base_url": "https://drivemusic.me",
            "search_path": "/?do=search&subaction=search&story={query}"
        },
        {
            "name": "hitmotop",
            "enabled": true,
            "driver": "drivers/music_downloader_hitmotop.py",
            "base_url": "https://rus.hitmotop.com",
            "search_path": "/search?q={query}"
        },
        {
            "name": "youtube_music",
            "enabled": true,
            "driver": "drivers/music_downloader_youtube_music.py",
            "base_url": "https://music.youtube.com",
            "search_path": "/search?q={query}#songs"
        }
    ],

    "artist_aliases": [
        ["Madi Syzdykov", "Мәди Сыздықов", "Мади Сыздыков", "Madi Syzdyq", "Madistation"]
    ],

    "sites": [
        {
            "site_name": "sefon.pro",
