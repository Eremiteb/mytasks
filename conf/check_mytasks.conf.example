# Конфигурация check_mytasks.sh — стартовой настройки и проверки mytasks.
# Создаётся самим скриптом при первом запуске (мастер в окне с описанием и
# значениями по умолчанию); вручную копировать не нужно.

# Каталог проекта mytasks. По умолчанию — каталог, откуда запущен скрипт.
# Подставляется вместо @MYTASKS_DIR@ в юниты systemd, ссылки
# ~/.local/bin и файлы автозапуска. Если репозиторий перенесён, скрипт
# предупредит о расхождении и предложит обновить значение и юниты.
MYTASKS_DIR="@MYTASKS_DIR@"

# Семейство ОС: arch (pacman), debian (apt-get), redhat (dnf/yum, Fedora
# Atomic — rpm-ostree), suse (zypper), alpine (apk), void (xbps-install),
# gentoo (emerge), solus (eopkg), nixos (без автоустановки пакетов).
# Мастер подставляет семейство, определённое по /etc/os-release (ID и
# ID_LIKE, в том числе производные: Garuda, Mint, Pop!_OS, Nobara, Rocky и
# т.п.); пусто — определять при каждом запуске. Нераспознанная ОС —
# предупреждение, пакеты ставятся вручную.
OS_FAMILY=""

# Команда повышения прав для системных юнитов и пакетов.
# auto — sudo -A при заданном SUDO_ASKPASS, иначе pkexec в графическом
# сеансе, иначе sudo в терминале; пусто — выполнять без повышения прав.
SUDO_CMD="auto"

# Garuda: полное обновление системы (обязательный первый шаг) через
# garuda-update — auto (обновляет зеркала, keyring, применяет hotfix) или
# чистым pacman -Syu — no
GARUDA_UPDATE="auto"

# Каталог установки llama.cpp: по нему определяется, нужны ли на этой машине llamactl, значок в
# трее и сервисы llama.cpp. Пусто — берётся LLAMA_PREFIX из conf/llamactl.conf, иначе /opt/llama.cpp
LLAMA_PREFIX=""

# Окна вопросов: auto — zenity (кнопки «Отмена» и «Стоп» во всех окнах), без
# него kdialog («Стоп» в вопросах и пунктом списка), без графики — терминал;
# kdialog — всегда kdialog; tty — только терминал; none — без вопросов.
UI="auto"

# Каталог системных юнитов systemd
SYSTEM_UNIT_DIR="/etc/systemd/system"

# Каталог root-копий скриптов (system_monitor.sh, root-хелпер llamactl-root):
# их запускают системные юниты и sudo, поэтому они лежат вне домашнего
# каталога, принадлежат root и не доступны пользователю на запись.
# Подставляется вместо @ROOT_LIB_DIR@ в системные юниты. Каталог (и все
# каталоги над ним) должен принадлежать root — иначе root-шаг откажет
ROOT_LIB_DIR="/usr/local/lib/mytasks"

# Каталог root-копий настроек (system_monitor.conf): root-копия скрипта
# читает только их. Подставляется вместо @ROOT_CONF_DIR@; требования — как
# у ROOT_LIB_DIR
ROOT_CONF_DIR="/etc/mytasks"

# Каталог пользовательских юнитов systemd
USER_UNIT_DIR="@HOME@/.config/systemd/user"

# Каталог автозапуска графического сеанса (XDG autostart)
AUTOSTART_DIR="@HOME@/.config/autostart"

# Каталог для команд-ссылок (llamactl и т.п.)
BIN_DIR="@HOME@/.local/bin"

# Системный Python для проверки модулей зависимостей (py:...). Пусто —
# /usr/bin/python3, а где его нет (NixOS) — python3 из PATH
SYSTEM_PYTHON=""

# Каталог модулей ядер: по нему определяется, что работающее ядро удалено
# после обновления и нужна перезагрузка
KERNEL_MODULES_DIR="/usr/lib/modules"

# Сколько последних JSONL-логов хранить
KEEP_LOGS=10

# Параметры уведомления о проблемах (режим --notify)
APP_NAME="MytasksCheck"
ICON_NAME="dialog-warning"
URGENCY="normal"

# Список заданий и зависимостей можно переопределить массивами JOBS и DEPS
# (формат и значения по умолчанию — в начале check_mytasks.sh).
