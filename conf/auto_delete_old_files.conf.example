# Каталоги для очистки: один путь на строку (обязательно).
# Пустые строки игнорируются; пути с пробелами поддерживаются.
TARGET_DIRS="/path/to/cleanup
/path/to/another cleanup"

# Типы файлов (расширения):
# - all (по умолчанию): удалять все типы
# - список через запятую: "log,tmp,bak"
# - список через пробел: "log tmp bak"
FILE_TYPES="all"

# Сколько дней хранить файлы.
# Удаляются только файлы старше этого значения (find -mtime +N).
KEEP_DAYS="30"
