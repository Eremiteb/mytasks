# Конфигурация check_backups.sh
# Скопируйте этот файл в conf/check_backups.conf и заполните своими значениями.

# Каталоги с архивами бэкапов (обязательно). Формат записи:
#   "каталог"                      — лимит возраста берётся из MAX_AGE_DAYS
#   "каталог|лимит_возраста_дней"  — свой лимит для этого каталога
BACKUP_DIRS=(
    "/mnt/store/backups"
    # "/mnt/copy/backups|7"
)

# Маски архивов (по умолчанию: *.tar.zst *.tar.gz *.tgz *.tar *.zip *.7z)
# ARCHIVE_PATTERNS=("*.tar.zst" "*.tar.gz" "*.zip")

# Максимальный возраст самого свежего архива, дней (cloud_backup — раз в сутки,
# поэтому 2 дня дают запас на один пропущенный запуск)
MAX_AGE_DAYS=2

# Минимальный размер самого свежего архива, байт
MIN_SIZE_BYTES=1

# Минимальная доля размера свежего архива от предыдущего, % (0 — не проверять).
# Резкое уменьшение обычно означает оборванную запись.
MIN_SIZE_RATIO_PCT=50

# Глубина поиска архивов в каталоге (1 — только сам каталог)
SEARCH_DEPTH=1

# Тайм-аут обращения к каталогу, с (защита от зависшего NFS; обращение
# также запускает автомонтирование x-systemd.automount)
ACCESS_TIMEOUT_SECS=15

# Проверять целостность самого свежего архива (zstd -t, gzip -t, unzip -t,
# 7z t, tar -t). Архив читается целиком: на NFS со скоростью ~110 МБ/с архив
# ~33 ГБ проверяется около 5 минут (замер 2026-10-04), поэтому проверка идёт
# с nice -n 19 / ionice -c3 и не повторяется для уже проверенного архива
# (запоминается в state/check_backups.verified).
VERIFY_INTEGRITY="yes"

# Тайм-аут проверки = размер_архива / VERIFY_MIN_SPEED_MBPS (МиБ/с, нижняя оценка
# скорости чтения) + VERIFY_TIMEOUT_BASE_SECS. Для 33 ГБ это ~28 минут.
# Тайм-аут — предупреждение в логе, а не ошибка бэкапа.
VERIFY_MIN_SPEED_MBPS=20
VERIFY_TIMEOUT_BASE_SECS=120

# Архив, изменённый менее N минут назад, считается ещё пишущимся —
# проверка целостности откладывается до следующего запуска
VERIFY_MIN_AGE_MINUTES=30

# Сколько последних JSONL-логов хранить
KEEP_LOGS=10

# Параметры desktop-уведомления в трее
APP_NAME="BackupCheck"
ICON_NAME="drive-harddisk"
URGENCY="critical"
