# Конфигурация split_by_dash.sh
# Скопируйте этот файл в split_by_dash.conf и заполните своими значениями.
# Укажите по одному пути к папке на каждой строке.

/path/to/music/
/path/to/downloads/

# Необязательно: каталог, куда переносить получившиеся после разбора папки.
# Если не указан — папки остаются на месте (внутри исходного каталога).
# DEST_DIR=/path/to/destination/
