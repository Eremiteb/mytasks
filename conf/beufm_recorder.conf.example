# Конфигурация beufm_recorder.py
# Скопируйте этот файл в conf/beufm_recorder.conf и заполните своими значениями.

# Альтернативные DNS-серверы через запятую (для fallback при сбое основного DNS)
# При ошибке "[Errno -3] Temporary failure in name resolution" скрипт попробует
# эти DNS-серверы для разрешения имён.
DNS_SERVERS="8.8.8.8,8.8.4.4,1.1.1.1,1.0.0.1"

# Сколько раз повторять попытку DNS с альтернативными серверами
DNS_RETRIES=3

# Пауза между попытками DNS, с
DNS_RETRY_DELAY=2

# Сколько последних JSONL-логов хранить
KEEP_LOGS=10

# Параметры desktop-уведомления
APP_NAME="BeuFMRecorder"
ICON_NAME="audio-x-generic"
URGENCY="normal"