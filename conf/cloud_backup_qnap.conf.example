# Конфигурация cloud_backup_qnap.sh (QNAP NAS)
# Скопируйте этот файл в cloud_backup_qnap.conf и заполните своими значениями.
#
# ВАЖНО: этот QNAP — отдельный WireGuard-клиент. Нельзя использовать те же
# приватный ключ/IP, что и у десктопного клиента (wg0-client) — на сервере
# должен быть заведён отдельный peer с уникальным ключом и адресом
# (например, 10.66.66.3/32), иначе будет конфликт адресов в туннеле.

# Имя WireGuard-интерфейса на QNAP (файл конфига: /opt/etc/wireguard/<имя>.conf)
WG_INTERFACE="wg0-qnap"

# IP-адрес удалённого сервера (тот же сервер, что и в cloud_backup.conf)
REMOTE_HOST="10.66.66.1"

# Логин SSH
REMOTE_USER="root"

# Пароль SSH (необязательно). В репозитории Entware для aarch64-k3.10 нет
# пакета sshpass, поэтому на QNAP рекомендуется оставить это поле пустым и
# использовать вместо пароля SSH-ключ (см. REMOTE_SSH_KEY ниже и инструкцию
# в шаге 2 заголовка cloud_backup_qnap.sh).
REMOTE_PASSWORD=""

# Путь к приватному SSH-ключу (рекомендуется для QNAP вместо REMOTE_PASSWORD)
REMOTE_SSH_KEY="/share/Public/entware/ssh-qnap/id_ed25519"

# Порт SSH (необязательно, по умолчанию 22)
REMOTE_SSH_PORT="22"

# Путь к папке на удалённой системе (необязательно, по умолчанию /opt/esimych-cloud)
REMOTE_PATH="/opt/esimych-cloud"

# Локальная папка на QNAP для резервных копий
# (типовой путь на QTS для общей папки "Public" — /share/Public/backups;
# /Public/backups обычно тоже работает как симлинк на тот же путь)
BACKUP_DIR="/share/Public/backups"

# Оставить WireGuard активным после завершения скрипта: 1 — да, 0 — нет (по умолчанию)
WG_KEEP_UP="0"

# Сколько последних резервных копий хранить (старше — удаляются)
BACKUP_KEEP_COUNT="5"

# Оптимизировать MariaDB перед архивированием: 1 — да, 0 — нет (по умолчанию)
OPTIMIZE_MARIADB_BEFORE_BACKUP="0"

# Имя сервиса MariaDB в docker compose
MARIADB_SERVICE_NAME="mariadb"

# Очистить старые binary logs перед бэкапом (может повлиять на репликацию): 1 — да, 0 — нет
MARIADB_PURGE_BINLOGS="0"

# Очистить файл general.log перед бэкапом: 1 — да, 0 — нет
MARIADB_TRUNCATE_GENERAL_LOG="1"

# Оптимизировать Redis AOF перед архивированием: 1 — да, 0 — нет (по умолчанию)
OPTIMIZE_REDIS_BEFORE_BACKUP="0"

# Имя сервиса Redis в docker compose
REDIS_SERVICE_NAME="redis"

# Максимальное ожидание завершения BGREWRITEAOF (сек)
REDIS_REWRITE_WAIT_SEC="180"

# Сколько последних строк docker compose logs снимать с Redis перед
# services_stop (docker compose down) — после down логи контейнера теряются
REDIS_LOG_TAIL_LINES="300"

# Раз в сколько дней реально выполнять включённые выше оптимизации БД
# (MariaDB/Redis), даже если сам бэкап запускается ежедневно.
# Между запусками, где интервал ещё не истёк, оптимизация пропускается —
# отметка о последнем запуске хранится в state/cloud_backup_qnap-db-optimize.state.
# Ежедневная оптимизация на скорость самого архивирования не влияет (узкое
# место — локальный CPU QNAP, а не состояние удалённых БД) и создаёт лишнюю
# нагрузку/риск на проде (MariaDB может делать recreate+analyze вместо
# лёгкого OPTIMIZE, Redis BGREWRITEAOF может не укладываться в таймаут).
DB_OPTIMIZE_INTERVAL_DAYS="7"

# Передача потока бэкапа через сырой TCP-сокет (nc/ncat) внутри уже
# зашифрованного WireGuard-туннеля, в обход дополнительного слоя SSH-шифрования
# (см. подробное обоснование в шапке cloud_backup_qnap.sh, шаг 8, и у
# SSH_CIPHERS ниже — двойное шифрование на единственном ядре CPU QNAP).
# По умолчанию выключено: 0 — сегодняшняя SSH-передача (без риска), 1 — новый
# способ. Перед включением на постоянку один раз откройте порт
# RAW_TRANSFER_PORT в фаерволе удалённого сервера (см. шаг 8 в шапке скрипта).
RAW_TRANSFER_ENABLED="0"
RAW_TRANSFER_PORT="8873"
#RAW_TRANSFER_CONNECT_RETRIES="10"
#RAW_TRANSFER_REMOTE_TIMEOUT_SEC="21600"
#RAW_TRANSFER_STATUS_POLL_RETRIES="5"

# Размер тестовой передачи (МБ) для замера реальной скорости сети
# QNAP<->REMOTE_HOST перед началом бэкапа (событие network_speed_test в логе,
# best-effort — при ошибке только предупреждение, бэкап не прерывается).
# Использует тот же nc -N + ncat --recv-only, что и сама передача, поэтому
# результат напрямую сравним с avg_mib_s в backup_metrics.
#NETWORK_SPEED_TEST_MB="50"

# Дополнительных переменных не требуется: во время передачи скрипт сам, раз в
# ~10 минут, совместно снимает CPU (loadavg), RAM (MemAvailable) и IO
# (/proc/diskstats устройства под BACKUP_DIR) на самом QNAP — событие
# backup_resource_diag в логе, среднее значение IO-загрузки за весь запуск —
# avg_io_util_pct в backup_metrics. Читается напрямую из ядра, без установки
# iostat/vmstat (в минимальной Entware-сборке этого QNAP таких пакетов нет).

# Приоритет шифров SSH (см. комментарий у SSH_OPTS в скрипте). По умолчанию
# первым идёт chacha20-poly1305 — на слабых ARM-чипах без аппаратного AES он
# обычно быстрее программного AES-GCM/CTR, а расшифровку входящего потока
# бэкапа выполняет именно QNAP (узкое место — его единственное ядро CPU).
# Переопределите, если замеры на вашем железе покажут другой шифр быстрее.
#SSH_CIPHERS="chacha20-poly1305@openssh.com,aes128-gcm@openssh.com,aes256-gcm@openssh.com,aes128-ctr"
