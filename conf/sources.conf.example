# Конфигурация sources.sh
# Скопируйте этот файл в sources.conf и заполните своими значениями.
# Формат каждой строки: SRC|DST|RSYNC_OPTS
# Строка, начинающаяся с «7z», — архив 7z вместо rsync:
#   7z|КАТАЛОГ|КАТАЛОГ_АРХИВОВ|СКОЛЬКО_ХРАНИТЬ|ОПЦИИ_7Z
# Архив «<имя каталога>-ГГГГ-ММ-ДД.7z», хранятся последние СКОЛЬКО_ХРАНИТЬ
# (0 — не удалять старые, пусто — 3); пустые ОПЦИИ_7Z — «-t7z -mx=5 -snl».
#
# Настройки скрипта — строки «ИМЯ=значение» в этом же файле (без пробелов
# вокруг «=»); необязательны. Чтобы изменить, уберите «# » в начале строки;
# ниже — значения по умолчанию.
#   SEVENZIP_BIN=7z                       программа архивации для строк «7z»
#   SEVENZIP_DEFAULT_OPTS=-t7z -mx=5 -snl опции 7z, если поле ОПЦИИ_7Z пустое
#   SEVENZIP_KEEP=3                       сколько архивов хранить, если поле
#                                         СКОЛЬКО_ХРАНИТЬ пустое (0 — не удалять)
#   LOG_KEEP_DAYS=10                      сколько дней хранить логи sources_*-report.jsonl

@HOME@/documents/|/mnt/backup/documents/|-arvhWP --delete
@HOME@/music/|/mnt/backup/music/|-arvhWP --delete
@HOME@/photos/|/mnt/backup/photos/|-arvhWP
7z|@HOME@/documents/|/mnt/backup/archives/|3|-t7z -mx=5 -snl
