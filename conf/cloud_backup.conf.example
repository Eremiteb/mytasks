# Конфигурация cloud_backup.sh
# Скопируйте этот файл в cloud_backup.conf и заполните своими значениями.

# Имя WireGuard-интерфейса (из /etc/wireguard/)
WG_INTERFACE="wg0"

# IP-адрес удалённого сервера
REMOTE_HOST="192.168.x.x"

# Логин SSH
REMOTE_USER="username"

# Пароль SSH
REMOTE_PASSWORD="password"

# Порт SSH (необязательно, по умолчанию 22)
REMOTE_SSH_PORT="22"

# Путь к папке на удалённой системе (необязательно, по умолчанию /opt/esimych-cloud)
REMOTE_PATH="/opt/esimych-cloud"

# Имя контейнера Nextcloud на удалённой системе и пользователь, от которого выполняется occ
# (очистка корзины и версий; необязательно, по умолчанию esimych-cloud-app и www-data)
NEXTCLOUD_CONTAINER="esimych-cloud-app"
NEXTCLOUD_EXEC_USER="www-data"

# Локальная папка для резервных копий
BACKUP_DIR="/mnt/store/backups"

# Пароль sudo (для wg-quick up/down без интерактивного терминала)
SUDO_PASSWORD="your_sudo_password"

# Оставить WireGuard активным после завершения скрипта: 1 — да, 0 — нет (по умолчанию)
WG_KEEP_UP="0"

# Сколько последних резервных копий и файлов логов хранить (старше — удаляются)
BACKUP_KEEP_COUNT="5"

# Оптимизировать MariaDB перед архивированием: 1 — да, 0 — нет (по умолчанию)
OPTIMIZE_MARIADB_BEFORE_BACKUP="0"

# Имя сервиса MariaDB в docker compose
MARIADB_SERVICE_NAME="mariadb"

# Очистить старые binary logs перед бэкапом (может повлиять на репликацию): 1 — да, 0 — нет
MARIADB_PURGE_BINLOGS="0"

# Очистить файл general.log перед бэкапом: 1 — да, 0 — нет
MARIADB_TRUNCATE_GENERAL_LOG="1"

# Порог деградации скорости архивирования, МиБ/с: средняя скорость ниже —
# предупреждение backup_degradation в логе (необязательно, по умолчанию 6)
BACKUP_DEGRADATION_MIBS_THRESHOLD="6"

# Пауза после подъёма WireGuard перед проверкой связи, с
WG_UP_WAIT_SECS="2"

# Проверка связи с сервером через VPN (ping): число попыток, тайм-аут одного
# ping и пауза между попытками, с
WG_PING_ATTEMPTS="3"
WG_PING_TIMEOUT_SECS="5"
WG_PING_RETRY_SECS="5"

# Тайм-аут установки SSH-соединения (ConnectTimeout), с
SSH_CONNECT_TIMEOUT_SECS="30"

# Шифры SSH через запятую (быстрые AEAD-шифры для передачи архива)
SSH_CIPHERS="aes128-gcm@openssh.com,chacha20-poly1305@openssh.com,aes256-gcm@openssh.com,aes128-ctr"

# Команды сжатия на сервере: берётся первая из доступных zstd, pigz, gzip.
# Для zstd обязателен ключ -c (запись в stdout); для pigz и gzip уровень -1..-9
COMP_ZSTD_CMD="zstd --fast=1 --threads=0 -c"
COMP_PIGZ_CMD="pigz -1"
COMP_GZIP_CMD="gzip -1"

# Как часто писать размер архива в лог во время архивирования, с
PROGRESS_INTERVAL_SECS="60"
