# Конфигурация all_to_mp3.sh (файл конфига называется audio_to_mp3.conf)
# Скопируйте этот файл в audio_to_mp3.conf и при необходимости измените значения.

# Какие расширения конвертировать, через пробел (без точки), например "flac wav ape".
# Пусто — обрабатывать все файлы, которые распознаёт ffprobe.
FORMATS=""

# Качество LAME VBR для ffmpeg (-q:a): 0 (лучшее) .. 9 (худшее).
QUALITY=0

# Имена файлов обложки в папке источника, через пробел; берётся первый найденный.
# Если ни одного нет — обложка извлекается из самого файла.
COVER_NAMES="cover.jpg folder.jpg front.jpg"

# Число параллельных процессов конвертации; 0 — по числу ядер (nproc).
JOBS=0

# Каталог, куда пишутся MP3, лог ошибок и отчёт (структура подпапок источника сохраняется).
OUTPUT_DIR="/mnt/copy/Music"

# Имя файла журнала ошибок (создаётся внутри OUTPUT_DIR).
ERROR_LOG="audio_to_mp3_errors.log"

# Имя файла отчёта о конвертации (создаётся внутри OUTPUT_DIR).
REPORT_FILE="audio_to_mp3_report.txt"
