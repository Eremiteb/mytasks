# Конфигурация doc2fb2.sh
# Скопируйте этот файл в doc2fb2.conf и при необходимости измените значения.
# Ключи командной строки (--toc/--no-toc, --toc-depth, --title-mode, --log-level) главнее конфига.

# Режим выбора названия книги: auto, filename (из имени файла) или keep (оставить как в документе).
TITLE_MODE="auto"

# Строить оглавление: 1 — да, 0 — нет.
TOC=1

# Глубина оглавления (число уровней заголовков), если TOC=1.
TOC_DEPTH=3

# Уровень журнала: info (всё) или error (только ошибки).
LOG_LEVEL="info"

# Сколько дней хранить старые файлы doc2fb2_*.jsonl рядом с логом; более старые удаляются.
LOG_KEEP_DAYS=10
