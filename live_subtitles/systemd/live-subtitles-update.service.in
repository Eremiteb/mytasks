# Обновление и подбор моделей live_subtitles (manage_models.py run): проверка новых версий, замеры на этом железе,
# запись выбора в ~/.local/state/live_subtitles/selected.json. Остановит сервис субтитров на время замеров
# (им нужна вся GPU) и запустит его снова.
[Unit]
Description=Обновление и подбор моделей live_subtitles
After=network-online.target llama-server.service
Wants=network-online.target
Requires=llama-server.service

[Service]
Type=oneshot
User=@USER@
Group=@USER@
WorkingDirectory=@PROJECT@
# Запускаться только когда пора (срок вышел или железо/llama.cpp изменились) и ничего не играет.
ExecCondition=@PROJECT@/venv/bin/python @PROJECT@/manage_models.py due
Environment=XDG_RUNTIME_DIR=/run/user/@UID@
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/@UID@/bus
Environment=HF_HOME=/var/lib/llama.cpp/hf-cache
# Сервис субтитров останавливаем только когда обновление реально началось (после ExecCondition), а не при каждом
# срабатывании таймера. Приставка «+» — выполнить от root: юнит работает от пользователя и сам остановить сервис не может.
ExecStartPre=+/usr/bin/systemctl stop live-subtitles.service
ExecStart=@PROJECT@/venv/bin/python -u @PROJECT@/manage_models.py run
# Вернуть сервис субтитров в любом случае (даже после ошибки замеров).
ExecStopPost=-+/usr/bin/systemctl start live-subtitles.service
TimeoutStartSec=3h
Nice=15
IOSchedulingClass=idle
